# CAN YOU OUTSMART AI? — Environment variables
# Copy to .env.local for local dev. Never commit .env.local.

# AI provider (server-only — never use NEXT_PUBLIC_ prefix)
# Groq OpenAI-compatible endpoint. Get a key at https://console.groq.com
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=https://api.groq.com/openai/v1

# Public, safe for the browser
NEXT_PUBLIC_CLUB_NAME=Husky Hackathon Society
NEXT_PUBLIC_TIMER_ENABLED=false
